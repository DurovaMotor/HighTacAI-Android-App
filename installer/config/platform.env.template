# Runtime settings consumed by pydantic-settings from ProgramData/config/.env.
# This rendered file contains a secret and must remain protected and untracked.
HIGHTAC_ENVIRONMENT="production"
HIGHTAC_HOST="0.0.0.0"
HIGHTAC_PORT="__WEB_PORT__"
HIGHTAC_DATA_DIR="__DATA_ROOT__"
HIGHTAC_AUTO_MIGRATE="true"
HIGHTAC_BOOTSTRAP_ADMIN="true"
HIGHTAC_BOOTSTRAP_ADMIN_USERNAME="__BOOTSTRAP_ADMIN_USERNAME__"
HIGHTAC_BOOTSTRAP_ADMIN_PASSWORD="__BOOTSTRAP_ADMIN_PASSWORD__"
HIGHTAC_LOG_TO_FILE="true"
HIGHTAC_MQTT_ENABLED="true"
HIGHTAC_MQTT_REQUIRED_FOR_READY="true"
HIGHTAC_MQTT_HOST="127.0.0.1"
HIGHTAC_MQTT_PORT="__MQTT_PORT__"
HIGHTAC_MQTT_USERNAME="__MQTT_PLATFORM_USERNAME__"
HIGHTAC_MQTT_PASSWORD="__MQTT_PLATFORM_PASSWORD__"
HIGHTAC_BROKER_MODE="windows_service"
HIGHTAC_BROKER_SERVICE_NAME="HighTacMqttBroker"
HIGHTAC_BROKER_LOG_PATH="__DATA_ROOT__/logs/mosquitto.log"
HIGHTAC_DEFAULT_SITE_NAME="__SITE_NAME__"

# Optional mobile third-party proxies. Leave credentials/IDs empty until the
# protected runtime .env is configured; the service still starts and returns a
# provider-specific 503 for an unconfigured integration.
HIGHTAC_OPENAI_API_KEY=""
HIGHTAC_OPENAI_BASE_URL="https://api.openai.com/v1"
HIGHTAC_OPENAI_MODEL="gpt-5.5"
HIGHTAC_JIANDAOYUN_API_KEY=""
HIGHTAC_JIANDAOYUN_APP_ID=""
HIGHTAC_JIANDAOYUN_ENTRY_ID=""
HIGHTAC_JIANDAOYUN_BASE_URL="https://api.jiandaoyun.com/api"
