{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hightac.local/events.schema.json",
  "title": "HighTac WebSocket Event",
  "description": "Strict version 1 event union. Clients must refresh REST snapshots after reconnect because events are not replayed.",
  "oneOf": [
    {"$ref": "#/$defs/BrokerStatusChangedEvent"},
    {"$ref": "#/$defs/StationStatusChangedEvent"},
    {"$ref": "#/$defs/StationHeartbeatEvent"},
    {"$ref": "#/$defs/TagStatusChangedEvent"},
    {"$ref": "#/$defs/BindingCreatedEvent"},
    {"$ref": "#/$defs/BindingRemovedEvent"},
    {"$ref": "#/$defs/CommandStatusChangedEvent"},
    {"$ref": "#/$defs/DeviceStatusChangedEvent"},
    {"$ref": "#/$defs/SystemNoticeEvent"}
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "StationId": {
      "type": "string",
      "pattern": "^90A9F[0-9A-F]{7}$"
    },
    "TagId": {
      "type": "string",
      "pattern": "^AD1[0-9A-F]{9}$"
    },
    "StationStatus": {
      "type": "string",
      "enum": ["UNKNOWN", "ONLINE", "STALE", "OFFLINE"]
    },
    "BrokerStatus": {
      "type": "string",
      "enum": ["STOPPED", "STARTING", "RUNNING", "STOPPING", "FAILED", "UNKNOWN"]
    },
    "CommandStatus": {
      "type": "string",
      "enum": ["ACCEPTED", "PUBLISHED", "CONFIRMED", "PARTIALLY_CONFIRMED", "UNCONFIRMED", "FAILED", "SUPERSEDED"]
    },
    "CommandItemStatus": {
      "type": "string",
      "enum": ["PENDING", "PUBLISHED", "CONFIRMED", "UNCONFIRMED", "FAILED", "SUPERSEDED"]
    },
    "DeviceStatus": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "REVOKED"]
    },
    "EventBase": {
      "type": "object",
      "required": [
        "event_id",
        "schema_version",
        "event_type",
        "occurred_at",
        "entity_type",
        "entity_id",
        "payload"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/Uuid"},
        "schema_version": {"type": "integer", "const": 1},
        "event_type": {
          "type": "string",
          "enum": [
            "broker.status_changed",
            "station.status_changed",
            "station.heartbeat",
            "tag.status_changed",
            "binding.created",
            "binding.removed",
            "command.status_changed",
            "device.status_changed",
            "system.notice"
          ]
        },
        "occurred_at": {"$ref": "#/$defs/Timestamp"},
        "entity_type": {
          "type": "string",
          "enum": ["broker", "station", "tag", "binding", "command", "device", "system"]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {"type": "object"}
      }
    },
    "BrokerStatusChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_status",
        "current_status",
        "windows_service_running",
        "tcp_reachable",
        "mqtt_connected",
        "subscriptions_ready",
        "endpoint",
        "reason"
      ],
      "properties": {
        "previous_status": {"$ref": "#/$defs/BrokerStatus"},
        "current_status": {"$ref": "#/$defs/BrokerStatus"},
        "windows_service_running": {"type": "boolean"},
        "tcp_reachable": {"type": "boolean"},
        "mqtt_connected": {"type": "boolean"},
        "subscriptions_ready": {"type": "boolean"},
        "endpoint": {
          "type": "string",
          "pattern": "^[^\\s:]+:[0-9]{1,5}$"
        },
        "reason": {
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    },
    "BrokerStatusChangedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "broker.status_changed"},
            "entity_type": {"const": "broker"},
            "entity_id": {"const": "HighTacMqttBroker"},
            "payload": {"$ref": "#/$defs/BrokerStatusChangedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "StationStatusChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "previous_status", "current_status", "last_heartbeat_at", "broker_connected", "reason"],
      "properties": {
        "station_id": {"$ref": "#/$defs/StationId"},
        "previous_status": {"$ref": "#/$defs/StationStatus"},
        "current_status": {"$ref": "#/$defs/StationStatus"},
        "last_heartbeat_at": {
          "oneOf": [
            {"$ref": "#/$defs/Timestamp"},
            {"type": "null"}
          ]
        },
        "broker_connected": {"type": "boolean"},
        "reason": {
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    },
    "StationStatusChangedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "station.status_changed"},
            "entity_type": {"const": "station"},
            "entity_id": {"$ref": "#/$defs/StationId"},
            "payload": {"$ref": "#/$defs/StationStatusChangedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "StationHeartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_id",
        "status",
        "mac",
        "alias",
        "server_address",
        "heartbeat_seconds",
        "firmware_version",
        "total_count",
        "send_count"
      ],
      "properties": {
        "station_id": {"$ref": "#/$defs/StationId"},
        "status": {"$ref": "#/$defs/StationStatus"},
        "mac": {"type": "string", "maxLength": 64},
        "alias": {"type": ["string", "null"], "maxLength": 128},
        "server_address": {"type": "string", "maxLength": 255},
        "heartbeat_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "firmware_version": {"type": "string", "maxLength": 64},
        "total_count": {"type": "integer", "minimum": 0},
        "send_count": {"type": "integer", "minimum": 0}
      }
    },
    "StationHeartbeatEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "station.heartbeat"},
            "entity_type": {"const": "station"},
            "entity_id": {"$ref": "#/$defs/StationId"},
            "payload": {"$ref": "#/$defs/StationHeartbeatPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "TagStatusChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_id",
        "station_id",
        "online",
        "last_seen_at",
        "battery_raw",
        "battery_voltage",
        "battery_level",
        "low_battery",
        "is_abnormal",
        "abnormal_reason",
        "last_result_type"
      ],
      "properties": {
        "tag_id": {"$ref": "#/$defs/TagId"},
        "station_id": {
          "oneOf": [
            {"$ref": "#/$defs/StationId"},
            {"type": "null"}
          ]
        },
        "online": {"type": "boolean"},
        "last_seen_at": {
          "oneOf": [
            {"$ref": "#/$defs/Timestamp"},
            {"type": "null"}
          ]
        },
        "battery_raw": {"type": ["integer", "null"], "minimum": 0},
        "battery_voltage": {"type": ["number", "null"], "minimum": 0},
        "battery_level": {
          "type": ["integer", "null"],
          "enum": [0, 10, 30, 60, 80, 90, 100, null]
        },
        "low_battery": {"type": "boolean"},
        "is_abnormal": {"type": "boolean"},
        "abnormal_reason": {"type": ["string", "null"], "maxLength": 512},
        "last_result_type": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
      }
    },
    "TagStatusChangedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "tag.status_changed"},
            "entity_type": {"const": "tag"},
            "entity_id": {"$ref": "#/$defs/TagId"},
            "payload": {"$ref": "#/$defs/TagStatusChangedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BindingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "product_id",
        "product_code",
        "product_name",
        "tag_id",
        "site_id",
        "station_id",
        "source",
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/Uuid"},
        "product_id": {"$ref": "#/$defs/Uuid"},
        "product_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "product_name": {"type": ["string", "null"], "maxLength": 256},
        "tag_id": {"$ref": "#/$defs/TagId"},
        "site_id": {"$ref": "#/$defs/Uuid"},
        "station_id": {"$ref": "#/$defs/StationId"},
        "source": {"type": "string", "enum": ["ANDROID", "WEB", "MIGRATION"]},
        "actor_type": {"type": "string", "enum": ["ADMIN", "ANDROID", "SYSTEM"]},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "BindingCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "bound_at"],
      "properties": {
        "binding": {"$ref": "#/$defs/BindingSnapshot"},
        "bound_at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "BindingCreatedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "binding.created"},
            "entity_type": {"const": "binding"},
            "entity_id": {"$ref": "#/$defs/Uuid"},
            "payload": {"$ref": "#/$defs/BindingCreatedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BindingRemovedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "unbound_at", "replacement_binding_id"],
      "properties": {
        "binding": {"$ref": "#/$defs/BindingSnapshot"},
        "unbound_at": {"$ref": "#/$defs/Timestamp"},
        "replacement_binding_id": {
          "oneOf": [
            {"$ref": "#/$defs/Uuid"},
            {"type": "null"}
          ]
        }
      }
    },
    "BindingRemovedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "binding.removed"},
            "entity_type": {"const": "binding"},
            "entity_id": {"$ref": "#/$defs/Uuid"},
            "payload": {"$ref": "#/$defs/BindingRemovedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CommandItemUpdate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["item_id", "tag_id", "station_id", "previous_status", "current_status", "correlation", "result_type"],
      "properties": {
        "item_id": {"$ref": "#/$defs/Uuid"},
        "tag_id": {"$ref": "#/$defs/TagId"},
        "station_id": {"$ref": "#/$defs/StationId"},
        "previous_status": {"$ref": "#/$defs/CommandItemStatus"},
        "current_status": {"$ref": "#/$defs/CommandItemStatus"},
        "correlation": {
          "type": "string",
          "enum": ["NONE", "HEURISTIC_STATION_TAG_TIME", "HEURISTIC_STATE_MATCH"]
        },
        "result_type": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
      }
    },
    "CommandStatusChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "action",
        "previous_status",
        "current_status",
        "target_count",
        "confirmed_count",
        "unconfirmed_count",
        "failed_count",
        "item"
      ],
      "properties": {
        "command_id": {"$ref": "#/$defs/Uuid"},
        "action": {"type": "string", "enum": ["LIGHT_ON", "LIGHT_OFF"]},
        "previous_status": {"$ref": "#/$defs/CommandStatus"},
        "current_status": {"$ref": "#/$defs/CommandStatus"},
        "target_count": {"type": "integer", "minimum": 0},
        "confirmed_count": {"type": "integer", "minimum": 0},
        "unconfirmed_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "item": {"$ref": "#/$defs/CommandItemUpdate"}
      }
    },
    "CommandStatusChangedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "command.status_changed"},
            "entity_type": {"const": "command"},
            "entity_id": {"$ref": "#/$defs/Uuid"},
            "payload": {"$ref": "#/$defs/CommandStatusChangedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DeviceStatusChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "display_name", "previous_status", "current_status", "manufacturer", "model", "app_version", "reason"],
      "properties": {
        "device_id": {"$ref": "#/$defs/Uuid"},
        "display_name": {"type": ["string", "null"], "maxLength": 128},
        "previous_status": {"$ref": "#/$defs/DeviceStatus"},
        "current_status": {"$ref": "#/$defs/DeviceStatus"},
        "manufacturer": {"type": "string", "minLength": 1, "maxLength": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "app_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "reason": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "DeviceStatusChangedEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "device.status_changed"},
            "entity_type": {"const": "device"},
            "entity_id": {"$ref": "#/$defs/Uuid"},
            "payload": {"$ref": "#/$defs/DeviceStatusChangedPayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SystemNoticePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "resource_type", "resource_id"],
      "properties": {
        "severity": {"type": "string", "enum": ["INFO", "WARNING", "ERROR"]},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "resource_type": {"type": ["string", "null"], "maxLength": 64},
        "resource_id": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "SystemNoticeEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "event_type": {"const": "system.notice"},
            "entity_type": {"const": "system"},
            "entity_id": {"const": "HighTacPlatform"},
            "payload": {"$ref": "#/$defs/SystemNoticePayload"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
