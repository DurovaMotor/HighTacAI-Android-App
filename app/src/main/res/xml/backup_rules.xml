<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Unlisted, non-sensitive app data remains eligible for backup and transfer. -->
    <exclude
        domain="sharedpref"
        path="hightac_platform_protected_credentials.xml" />
    <exclude
        domain="sharedpref"
        path="light_station_config.xml" />
    <exclude
        domain="sharedpref"
        path="price_initial_refresh_v1.xml" />
    <exclude
        domain="database"
        path="hightac-platform-read-cache.db" />
    <exclude
        domain="database"
        path="hightac-platform-read-cache.db-wal" />
    <exclude
        domain="database"
        path="hightac-platform-read-cache.db-shm" />
</full-backup-content>
