<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Unlisted, non-sensitive app data remains eligible for cloud backup. -->
        <exclude
            domain="sharedpref"
            path="hightac_platform_protected_credentials.xml" />
        <exclude
            domain="sharedpref"
            path="light_station_config.xml" />
        <exclude
            domain="sharedpref"
            path="price_initial_refresh_v1.xml" />
        <exclude
            domain="database"
            path="hightac-platform-read-cache.db" />
        <exclude
            domain="database"
            path="hightac-platform-read-cache.db-wal" />
        <exclude
            domain="database"
            path="hightac-platform-read-cache.db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Unlisted, non-sensitive app data remains eligible for device transfer. -->
        <exclude
            domain="sharedpref"
            path="hightac_platform_protected_credentials.xml" />
        <exclude
            domain="sharedpref"
            path="light_station_config.xml" />
        <exclude
            domain="sharedpref"
            path="price_initial_refresh_v1.xml" />
        <exclude
            domain="database"
            path="hightac-platform-read-cache.db" />
        <exclude
            domain="database"
            path="hightac-platform-read-cache.db-wal" />
        <exclude
            domain="database"
            path="hightac-platform-read-cache.db-shm" />
    </device-transfer>
</data-extraction-rules>
